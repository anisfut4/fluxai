let filt='all',srch='';
const stPill={disparu:'<span class="pill pr">☠ Disparu</span>',quasi_mort:'<span class="pill pr">▼▼ Quasi-mort</span>',forte_baisse:'<span class="pill pw">▼ Forte baisse</span>',baisse:'<span class="pill pn">↘ Baisse</span>',stable:'<span class="pill pn">— Stable</span>',croissance:'<span class="pill pg">↗ Croissance</span>',explosion:'<span class="pill pg">▲▲ Explosion</span>',nouveau:'<span class="pill pb">★ Nouveau</span>'};
function renderSkus(){
 let d=SKUS;
 if(filt!=='all')d=d.filter(s=>s.st===filt);
 if(srch)d=d.filter(s=>s.s.toLowerCase().includes(srch)||s.p.toLowerCase().includes(srch)||s.c.toLowerCase().includes(srch));
 // sort: by |d| descending for interest
 d=[...d].sort((a,b)=>Math.abs(b.d)-Math.abs(a.d));
 document.getElementById('skuBody').innerHTML=d.map(s=>`<tr>
   <td><div class="pname" title="${s.p}">${s.p}</div><div class="psku">${s.s}</div></td>
   <td><span class="pill pp">${s.c}</span></td>
   <td class="num" style="color:var(--t3)">${fmt(s.ca25)}</td>
   <td class="num" style="font-weight:700;color:var(--navy)">${fmt(s.ca26)}</td>
   <td class="num ${s.d>=0?'g':'r'}">${fmtD(s.d)}</td>
   <td>${fmtP(s.pct)}</td>
   <td class="num" style="color:var(--t3)">${fmt(s.m25)}</td>
   <td class="num ${s.m26>=0?'':'r'}">${fmt(s.m26)}</td>
   <td class="num" style="color:var(--t3)">${s.q25.toLocaleString('fr-FR')}</td>
